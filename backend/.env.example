MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/chegouzap
JWT_SECRET=crie-uma-chave-longa-e-aleatoria
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional. Deixe vazio enquanto não tiver domínio público no R2.
R2_PUBLIC_URL=
R2_BUCKET=chegouzap-arquivos
# Chaves Web Push. Gere um par VAPID antes de ativar notificações no navegador.
VAPID_EMAIL=mailto:seu-email@exemplo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PORT=3001
